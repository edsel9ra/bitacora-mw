# Pass this file explicitly with: docker compose --env-file .env.production ...
APP_ENV=production

MYSQL_HOST=db
MYSQL_DATABASE=bitacora_mw
MYSQL_USER=bitacora_user
MYSQL_PASSWORD=change_this_database_password
MYSQL_ROOT_PASSWORD=change_this_root_password

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_AUTH=true
SMTP_USER=replace_with_smtp_user
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=bitacora@example.com
SMTP_VERIFY_TLS=true
SMTP_TIMEOUT_SECONDS=20
SMTP_HELO_NAME=bitacora.example.com

# Set false only for a temporary HTTP-only test. Use true with HTTPS in production.
SESSION_SECURE=true
SESSION_SAMESITE=Lax
SESSION_IDLE_TIMEOUT_SECONDS=3600
SESSION_MAX_LIFETIME_SECONDS=43200
BITACORA_STORAGE_PATH=/var/www/html/storage/bitacoras_pdf
BITACORA_PDF_TTL_DAYS=90
BITACORA_DRAFT_TTL_DAYS=30
BITACORA_DRAFT_MAX_BYTES=262144
# Generate once with: openssl rand -base64 32. Keep the same key to recover existing drafts.
BITACORA_DRAFT_KEY_BASE64=
BITACORA_DRAFT_KEYRING_JSON=
BITACORA_DRAFT_ACTIVE_KEY_VERSION=1
BITACORA_MAIL_ASYNC=true
BITACORA_SUBMISSION_CLAIM_TTL_SECONDS=300
BITACORA_MAIL_WORKER_LIMIT=20
BITACORA_MAIL_WORKER_INTERVAL_SECONDS=15
BITACORA_MAIL_WORKER_HEALTH_MAX_AGE_SECONDS=900
BITACORA_MAINTENANCE_INTERVAL_SECONDS=3600
BITACORA_MAINTENANCE_BATCH_SIZE=500
BITACORA_MAINTENANCE_MAX_BATCHES=20
BITACORA_MAINTENANCE_HEALTH_MAX_AGE_SECONDS=7500
APP_ENABLE_LEGACY_BITACORA=false
