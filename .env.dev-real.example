# Use only with docker-compose.dev-real.yml and a development SMTP account.
# Never commit the real values in this file or in .env.dev-real.
# If db_data already exists, MYSQL_* must match the credentials used to create it.
MYSQL_DATABASE=php_app
MYSQL_USER=php_user
MYSQL_PASSWORD=replace_with_dev_database_password
MYSQL_ROOT_PASSWORD=replace_with_dev_root_password

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_AUTH=true
SMTP_USER=replace_with_dev_smtp_user
SMTP_PASSWORD=replace_with_dev_smtp_password
SMTP_FROM=dev-bitacora@example.com
SMTP_VERIFY_TLS=true
SMTP_TIMEOUT_SECONDS=20
SMTP_HELO_NAME=dev.example.com

SESSION_SECURE=false
SESSION_SAMESITE=Lax
SESSION_IDLE_TIMEOUT_SECONDS=3600
SESSION_MAX_LIFETIME_SECONDS=43200
BITACORA_STORAGE_PATH=/var/www/html/storage/bitacoras_pdf
BITACORA_PDF_TTL_DAYS=90
BITACORA_DRAFT_TTL_DAYS=30
BITACORA_DRAFT_MAX_BYTES=262144
BITACORA_DRAFT_KEY_BASE64=replace_with_base64_of_32_random_bytes
BITACORA_DRAFT_KEYRING_JSON=
BITACORA_DRAFT_ACTIVE_KEY_VERSION=1
BITACORA_MAIL_ASYNC=false
BITACORA_SUBMISSION_CLAIM_TTL_SECONDS=300
APP_ENABLE_LEGACY_BITACORA=false
